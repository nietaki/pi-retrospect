{
  "name": "pi-retrospect",
  "version": "0.1.0",
  "description": "Explore past Pi sessions and their messages",
  "type": "module",
  "keywords": ["pi-package"],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
